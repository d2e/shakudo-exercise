# Kubernetes & Helm Artifacts
*.tgz
*.lock
charts/*/charts/
charts/*/Chart.lock

# Secret values (NEVER commit plain secrets)
environments/**/secrets.yaml
environments/**/*.secrets.yaml
!environments/**/secrets.example.yaml
!environments/**/*.secrets.example.yaml

# Environment & local overrides
.env
.env.*
.venv/
*.local

# Python artifacts
__pycache__/
*.egg-info/
build/
*.pyc
.pytest_cache/

# Logs
*.log

# Editor & Backup artifacts
*.swp
*.bak
*.tmp
*~
*.orig

# IDE & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Rendered output scratch directories
tmp/
output/
rendered/
