{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "api-service Helm Chart Values",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "service", "resources", "config"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "Never", "IfNotPresent"] },
        "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" }, "description": "Pinned tag; ':latest' is prohibited" }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "partOf": { "type": "string" },
    "extraLabels": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "seccompProfile": { "type": "object" }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities", "runAsNonRoot"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "capabilities": { "type": "object" },
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 }
      }
    },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": ["string", "integer"] },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "type": "object" },
        "liveness": { "type": "object" },
        "readiness": { "type": "object" }
      }
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": { "type": "object" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30, "maximum": 300 },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "allowedNamespaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
      "description": "Namespaces the API may act in (D21). Empty denies all."
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "array" },
        "egress": { "type": "array" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {
          "type": "object",
          "description": "Non-secret settings (environment variables read by api_service/config.py)",
          "propertyNames": {
            "enum": [
              "ENVIRONMENT", "LOG_LEVEL", "MOCK_AUTH_ENABLED",
              "OIDC_ISSUER", "OIDC_AUDIENCE", "OIDC_DISCOVERY_URL",
              "ACCESS_TOKEN_TTL_SECONDS", "REFRESH_TOKEN_TTL_SECONDS", "CLOCK_SKEW_SECONDS",
              "JWKS_CACHE_TTL_SECONDS", "JWKS_REFETCH_COOLDOWN_SECONDS", "JWKS_MAX_STALE_SECONDS",
              "ALLOWED_REGISTRIES", "MAX_REPLICAS", "MAX_CPU_LIMIT", "MAX_MEMORY_LIMIT",
              "DEFAULT_CPU_REQUEST", "DEFAULT_MEMORY_REQUEST", "DEFAULT_CPU_LIMIT", "DEFAULT_MEMORY_LIMIT",
              "PROGRESS_DEADLINE_SECONDS", "MAX_BODY_BYTES",
              "RATE_LIMIT_AUTH_PER_MINUTE", "RATE_LIMIT_MUTATE_PER_MINUTE", "RATE_LIMIT_READ_PER_MINUTE",
              "CORS_ALLOWED_ORIGINS",
              "KUBE_API_SERVER", "KUBE_CA_FILE", "KUBE_TOKEN_FILE", "KUBE_VERIFY_TLS",
              "KUBE_REQUEST_TIMEOUT_SECONDS",
              "OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_EXPORTER_OTLP_PROTOCOL",
              "OTEL_SERVICE_NAME", "OTEL_RESOURCE_ATTRIBUTES"
            ]
          },
          "additionalProperties": { "type": ["string", "integer", "boolean"] },
          "properties": {
            "ENVIRONMENT": { "enum": ["dev", "staging", "prod"] },
            "LOG_LEVEL": { "enum": ["debug", "info", "warn", "warning", "error", "critical"] },
            "CORS_ALLOWED_ORIGINS": { "type": "string", "not": { "pattern": "\\*" } },
            "DEFAULT_CPU_REQUEST": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?m?$" },
            "DEFAULT_CPU_LIMIT": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?m?$" },
            "DEFAULT_MEMORY_REQUEST": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|k|M|G|T)?$" },
            "DEFAULT_MEMORY_LIMIT": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|k|M|G|T)?$" }
          },
          "if": { "required": ["ENVIRONMENT"], "properties": { "ENVIRONMENT": { "const": "dev" } } },
          "else": {
            "required": ["MOCK_AUTH_ENABLED"],
            "properties": { "MOCK_AUTH_ENABLED": { "enum": ["false", false] } }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "bootstrapSecretKey": { "type": "string" },
        "signingKey": { "type": "string" }
      }
    },
    "secretData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "data": { "type": "object" }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
